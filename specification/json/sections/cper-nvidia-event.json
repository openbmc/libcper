{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Nvidia Event Section - Structured event format for NVIDIA devices",
    "required": ["eventHeader", "eventInfo", "eventContexts"],
    "additionalProperties": false,
    "properties": {
        "eventHeader": {
            "type": "object",
            "description": "Event header containing event metadata and identification",
            "required": [
                "signature",
                "version",
                "sourceDeviceType",
                "type",
                "subtype"
            ],
            "additionalProperties": false,
            "properties": {
                "signature": {
                    "type": "string",
                    "description": "Event signature string"
                },
                "version": {
                    "type": "integer",
                    "description": "Event header version number",
                    "minimum": 0
                },
                "sourceDeviceType": {
                    "type": "string",
                    "enum": ["CPU", "GPU", "DPU", "NIC", "SWX", "BMC"]
                },
                "type": {
                    "type": "string",
                    "description": "Event type code",
                    "pattern": "^0x[0-9a-fA-F]{4}$"
                },
                "typeName": {
                    "type": "string",
                    "description": "Decoded GPU event category name when the type code is recognized.",
                    "enum": [
                        "Timeout",
                        "MemoryIntegrityError",
                        "InterconnectError",
                        "CorruptionDetected",
                        "SecurityError",
                        "PowerError",
                        "ThermalError",
                        "FirmwareFault",
                        "EngineError",
                        "ResourceExhausted",
                        "TranslationFault",
                        "UnclassifiedError",
                        "Initialization",
                        "Shutdown",
                        "StateChanged",
                        "ConfigChanged",
                        "ResourceRetirement",
                        "ResourceThreshold",
                        "Telemetry",
                        "Debug"
                    ]
                },
                "subtype": {
                    "type": "string",
                    "description": "Event subtype code",
                    "pattern": "^0x[0-9a-fA-F]{4}$"
                },
                "traceId": {
                    "type": "string",
                    "description": "Event Trace ID (spec byte offset 8, 8 bytes). When non-zero, refers to a group of related events all sharing the same Trace ID.",
                    "pattern": "^0x[0-9a-fA-F]{16}$"
                },
                "linkId": {
                    "type": "string",
                    "description": "Deprecated alias for traceId, retained for encoding existing libCPER JSON.",
                    "deprecated": true,
                    "pattern": "^0x[0-9a-fA-F]{16}$"
                }
            }
        },
        "eventInfo": {
            "type": "object",
            "description": "Device-specific event information structure (varies by sourceDeviceType)",
            "required": ["version"],
            "additionalProperties": false,
            "properties": {
                "version": {
                    "type": "string",
                    "description": "Event info version as major.minor (high byte = major, low byte = minor)",
                    "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "cpu": { "type": "object" },
                "gpu": { "type": "object" }
            },
            "oneOf": [
                {
                    "required": ["cpu"],
                    "not": { "required": ["gpu"] },
                    "properties": {
                        "version": { "pattern": "^0\\.[0-9]+$" },
                        "cpu": {
                            "$ref": "./sections/cper-nvidia-event-info-cpu.json"
                        }
                    }
                },
                {
                    "required": ["gpu"],
                    "not": { "required": ["cpu"] },
                    "properties": {
                        "version": { "const": "1.0" },
                        "gpu": {
                            "$ref": "./sections/cper-nvidia-event-info-gpu-v1.json"
                        }
                    }
                },
                {
                    "required": ["gpu"],
                    "not": { "required": ["cpu"] },
                    "properties": {
                        "version": { "const": "2.0" },
                        "gpu": {
                            "$ref": "./sections/cper-nvidia-event-info-gpu-v2.json"
                        }
                    }
                }
            ]
        },
        "eventContexts": {
            "type": "array",
            "description": "Array of event context objects containing error details",
            "items": {
                "type": "object",
                "description": "Individual event context with header and data",
                "required": [
                    "version",
                    "dataFormatType",
                    "dataFormatVersion",
                    "dataSize",
                    "data"
                ],
                "additionalProperties": false,
                "properties": {
                    "version": { "type": "integer", "minimum": 0 },
                    "dataFormatType": {
                        "type": "string",
                        "description": "Context format identifier. Unknown category-specific 0x900x and event-specific 0xAxxx formats are preserved in data.opaque.",
                        "pattern": "^0x[0-9a-fA-F]{4}$"
                    },
                    "dataFormatVersion": {
                        "description": "Data format version as 'major.minor' per spec v0.6.",
                        "oneOf": [
                            {
                                "type": "string",
                                "pattern": "^[0-9]+\\.[0-9]+$"
                            },
                            { "type": "integer", "minimum": 0 }
                        ]
                    },
                    "dataSize": { "type": "integer", "minimum": 0 },
                    "data": {
                        "type": "object",
                        "description": "Context data (varies by dataFormatType and sourceDeviceType)",
                        "required": [],
                        "additionalProperties": false,
                        "properties": {
                            "opaque": {
                                "$ref": "./sections/cper-nvidia-event-data-opaque.json"
                            },
                            "type1": {
                                "$ref": "./sections/cper-nvidia-event-data-type1.json"
                            },
                            "type2": {
                                "$ref": "./sections/cper-nvidia-event-data-type2.json"
                            },
                            "type3": {
                                "$ref": "./sections/cper-nvidia-event-data-type3.json"
                            },
                            "type4": {
                                "$ref": "./sections/cper-nvidia-event-data-type4.json"
                            },
                            "gpuInitMetadata": {
                                "$ref": "./sections/cper-nvidia-event-data-gpu-init-metadata.json"
                            },
                            "gpuLegacyXid": {
                                "$ref": "./sections/cper-nvidia-event-data-gpu-legacy-xid.json"
                            },
                            "gpuRecommendedActions": {
                                "$ref": "./sections/cper-nvidia-event-data-gpu-recommended-actions.json"
                            },
                            "gpuTimeoutData": {
                                "$ref": "./sections/cper-nvidia-event-data-gpu-timeout.json"
                            }
                        },
                        "oneOf": [
                            { "required": ["opaque"] },
                            { "required": ["type1"] },
                            { "required": ["type2"] },
                            { "required": ["type3"] },
                            { "required": ["type4"] },
                            { "required": ["gpuInitMetadata"] },
                            { "required": ["gpuLegacyXid"] },
                            { "required": ["gpuRecommendedActions"] },
                            { "required": ["gpuTimeoutData"] }
                        ]
                    }
                }
            }
        }
    }
}
