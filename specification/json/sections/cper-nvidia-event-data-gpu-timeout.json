{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "GPU timeout category context data (GPU dataFormatType=0x9001, version 1.0)",
    "additionalProperties": false,
    "required": ["timeoutNs", "elapsedNs", "waitTarget"],
    "properties": {
        "timeoutNs": {
            "type": "string",
            "description": "Configured timeout duration in nanoseconds.",
            "pattern": "^0x[0-9a-fA-F]{16}$"
        },
        "elapsedNs": {
            "type": "string",
            "description": "Elapsed duration in nanoseconds.",
            "pattern": "^0x[0-9a-fA-F]{16}$"
        },
        "waitTarget": {
            "type": "string",
            "description": "NUL-terminated name of the resource or operation being awaited.",
            "maxLength": 31
        }
    }
}
